{
    "name": "bark-worker",
    "description": "Bark Server on Cloudflare Worker",
    "type": "module",
    "cloudflare": {
        "label": "Bark Server",
        "products": [
            "Workers",
            "D1",
            "Durable Objects"
        ],
        "categories": [],
        "icon_urls": [],
        "docs_url": "https://developers.cloudflare.com/workers/",
        "preview_image_url": "https://github.com/cwxiaos/bark-worker/blob/master/doc/images/bark.jpeg",
        "dash": true
    },
    "devDependencies": {
        "miniflare": "5.20261102.0-beta",
        "wrangler": "^4.84.1"
    },
    "scripts": {
        "test": "node --test test/*.test.js",
        "test:unit": "node --test test/apns-credentials.test.js test/push-compatibility.test.js test/reminders.test.js",
        "build:check": "wrangler deploy --dry-run --outdir work/build",
        "cf-typegen": "wrangler types",
        "db:migrate": "wrangler d1 migrations apply database --local",
        "db:migrate:remote": "wrangler d1 migrations apply database --remote",
        "deploy": "wrangler deploy",
        "dev": "wrangler dev",
        "predeploy": "npm run db:migrate:remote",
        "preview": "wrangler dev"
    }
}
