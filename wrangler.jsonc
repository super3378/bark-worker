{
    "name": "bark-worker",
    "main": "main.js",
    "compatibility_date": "2026-03-01",
    "compatibility_flags": [
        "nodejs_compat"
    ],
    "observability": {
        "enabled": true
    },
    "d1_databases": [
        {
            "binding": "database",
            "database_name": "database",
            "database_id": "22da48b3-1370-48b5-894d-84704fa4f51b"
        }
    ],
    "keep_vars": true,
    "durable_objects": {
        "bindings": [
            { "name": "REMINDERS", "class_name": "ReminderScheduler" }
        ]
    },
    "migrations": [
        { "tag": "v1-reminders", "new_sqlite_classes": ["ReminderScheduler"] }
    ],
    "vars": {
        "ALLOW_NEW_DEVICE": "true",
        "ALLOW_QUERY_NUMS": "true",
        "ROOT_PATH": "/",
        // "BASIC_AUTH": ""
    }
}
